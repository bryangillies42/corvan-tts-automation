<!-- O painel fica paralelo à face superior do Custom_Tile. Z -30 mantém a UI rente sem ocultá-la na malha. -->
<!--
  Runtime contract (all values are shared because no visibility filter is used):
  Dynamic text: pvCurrent, pvMax, pmCurrent, pmMax, defenseValue, rdValue,
                versionLabel, refreshStatus, activeWeaponLabel, attackValue,
                damageValue, criticalValue, lastResult, activeEffects,
                activePowersLabel.
  Dynamic visual state: weapon_sword, weapon_shield, roll_attack, roll_damage,
                        roll_critical, power_combat_defensive, power_duel,
                        power_baluarte, power_baluarte_allies, power_provocacao.
  Lua may update `text`, `textColor`, `colors`, `interactable`, `isOn`, and `active`
  through self.UI.setAttribute. Buttons and inputs report their unique id.
-->

<Defaults>
        <Text color="#E8E2D5" fontSize="20" fontStyle="Bold"
              alignment="MiddleCenter" resizeTextForBestFit="true"
              resizeTextMinSize="12" resizeTextMaxSize="26"
              horizontalOverflow="Wrap" verticalOverflow="Truncate" />
        <Text class="caption" color="#AE9A74" fontSize="14" fontStyle="Bold"
              alignment="MiddleLeft" resizeTextMinSize="10" resizeTextMaxSize="16" />
        <Text class="muted" color="#9A9B9C" fontSize="15" fontStyle="Normal"
              resizeTextMinSize="10" resizeTextMaxSize="18" />
        <Text class="gold" color="#D2AA55" />
        <Text class="red" color="#E26955" />
        <Text class="blue" color="#63A8D5" />
        <Text class="green" color="#80BD72" />

        <Panel class="card" color="#10151AEF" outline="#343A40" outlineSize="1 1" />
        <Panel class="goldCard" color="#111315F5" outline="#9E7A31" outlineSize="2 2" />
        <Panel class="section" color="#0C1014ED" outline="#292F34" outlineSize="1 1" />

        <Button class="baseButton" fontSize="18" fontStyle="Bold" textColor="#EEE9DF"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="11" resizeTextMaxSize="20"
                colors="#1A2026|#28313A|#11161B|#090B0D88"
                outline="#41474D" outlineSize="1 1" padding="8 8 5 5" />
        <Button class="miniButton" fontSize="14" fontStyle="Bold" textColor="#DED8CC"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="10" resizeTextMaxSize="16"
                colors="#171C21|#28323A|#0E1216|#090B0D88"
                outline="#3A4045" outlineSize="1 1" padding="3 3 2 2" />
        <Button class="weaponButton" fontSize="18" fontStyle="Bold" textColor="#E7E0D3"
                textAlignment="MiddleLeft" resizeTextForBestFit="true"
                resizeTextMinSize="12" resizeTextMaxSize="19"
                colors="#14191E|#222A31|#0D1115|#090B0D88"
                outline="#4A5055" outlineSize="1 1" padding="18 12 8 8" />
        <Button class="powerButton" fontSize="16" fontStyle="Bold" textColor="#E7E0D3"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="11" resizeTextMaxSize="18"
                colors="#13191E|#232D35|#0D1115|#090B0D88"
                outline="#3B4B56" outlineSize="1 1" padding="8 8 5 5" />
        <Button class="skillButton" fontSize="14" fontStyle="Bold" textColor="#DAD7CE"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="10" resizeTextMaxSize="16"
                colors="#151A1F|#283139|#0D1115|#090B0D88"
                outline="#363C41" outlineSize="1 1" padding="4 4 2 2" />
        <Button class="dangerAction" fontSize="20" fontStyle="Bold" textColor="#F3DDD7"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="13" resizeTextMaxSize="22"
                colors="#6B2821|#8A3B30|#451B17|#21100F88"
                outline="#A44D3E" outlineSize="2 2" padding="7 7 4 4" />
        <Button class="goldAction" fontSize="20" fontStyle="Bold" textColor="#FFF0C6"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="13" resizeTextMaxSize="22"
                colors="#665018|#856D25|#44350F|#211A0988"
                outline="#B58B35" outlineSize="2 2" padding="7 7 4 4" />
        <Button class="greenAction" fontSize="20" fontStyle="Bold" textColor="#E3F3DF"
                textAlignment="MiddleCenter" resizeTextForBestFit="true"
                resizeTextMinSize="13" resizeTextMaxSize="22"
                colors="#28562A|#39723B|#19391B|#0D1C0E88"
                outline="#4E8C50" outlineSize="2 2" padding="7 7 4 4" />

        <InputField class="numberInput" fontSize="16" fontStyle="Bold"
                    textColor="#F0E9DC" color="#090C0F"
                    colors="#090C0F|#161D23|#050708|#05070888"
                    alignment="MiddleCenter" characterValidation="Integer"
                    characterLimit="3" caretColor="#D2AA55"
                    selectionColor="#826A35AA" outline="#52575C" outlineSize="1 1" />
        <InputField class="decimalInput" fontSize="16" fontStyle="Bold"
                    textColor="#F0E9DC" color="#090C0F"
                    colors="#090C0F|#161D23|#050708|#05070888"
                    alignment="MiddleCenter" characterValidation="Decimal"
                    characterLimit="8" caretColor="#63A8D5"
                    selectionColor="#376987AA" outline="#52575C" outlineSize="1 1" />
</Defaults>

<!-- A moldura usa exatamente o canvas físico 1870x841; o painel opaco fica
     centralizado dentro dele para cobrir texturas legadas sem borda dupla. -->
<Image id="panelBoardArt" active="false" image="__PANEL_UI_IMAGE_URL_XML__"
       width="1870" height="841" rectAlignment="MiddleCenter"
       position="0 0 -30" rotation="0 0 180" scale="0.25 0.25 1"
       preserveAspect="false" raycastTarget="false" />

<Panel id="corvanConsole" width="1700" height="750" rectAlignment="MiddleCenter"
       position="0 0 -30" rotation="0 0 180" scale="0.25 0.25 1"
       color="#07090CD8" outline="#8C6A2D" outlineSize="3 3" raycastTarget="true">

    <!-- Main HUD uses the inset content canvas inside the full board art. -->
    <VerticalLayout id="mainLayout" anchorMin="0 0" anchorMax="1 1"
                    offsetMin="14 10" offsetMax="-14 -10"
                    spacing="8" childForceExpandWidth="true" childForceExpandHeight="false">

        <!-- Header -->
        <Panel class="section" preferredHeight="112">
            <HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 8" offsetMax="-10 -8"
                              spacing="8" childForceExpandWidth="false" childForceExpandHeight="true">
                <Panel flexibleWidth="1" minWidth="530">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="12 3" offsetMax="-8 -3"
                                    spacing="0" childForceExpandWidth="true" childForceExpandHeight="false">
                        <Text text="CORVAN DURAS" fontSize="39" resizeTextMaxSize="42"
                              alignment="MiddleLeft" color="#E8E2D5" preferredHeight="43"
                              shadow="#000000CC" shadowDistance="2 -2" />
                        <Text text="VANGUARDA  //  CAVALEIRO 7" class="gold" fontSize="19"
                              alignment="MiddleLeft" preferredHeight="22" />
                        <Text text="Humano  •  Soldado  •  Valkaria" class="muted"
                              alignment="MiddleLeft" preferredHeight="17" />
                    </VerticalLayout>
                </Panel>

                <Panel class="card" preferredWidth="245">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 5" offsetMax="-8 -5"
                                    spacing="3" childForceExpandWidth="true" childForceExpandHeight="false">
                        <HorizontalLayout preferredHeight="34" spacing="3" childForceExpandWidth="false">
                            <Text text="PV" class="caption red" preferredWidth="42" />
                            <Text id="pvCurrent" text="78" class="red" fontSize="28" preferredWidth="50" />
                            <Text text="/" class="muted" preferredWidth="16" />
                            <Text id="pvMax" text="78" fontSize="24" preferredWidth="46" />
                        </HorizontalLayout>
                        <HorizontalLayout preferredHeight="34" spacing="4" childForceExpandWidth="false">
                            <Button id="pv_subtract" class="miniButton" text="−" onClick="dispatch"
                                    preferredWidth="48" fontSize="24" />
                            <InputField id="pv_adjust" class="numberInput" text="" placeholder="VALOR"
                                        onEndEdit="dispatch" preferredWidth="113" characterLimit="4" />
                            <Button id="pv_add" class="miniButton" text="+" onClick="dispatch"
                                    preferredWidth="48" fontSize="24" />
                        </HorizontalLayout>
                    </VerticalLayout>
                </Panel>

                <Panel class="card" preferredWidth="235">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 5" offsetMax="-8 -5"
                                    spacing="3" childForceExpandWidth="true" childForceExpandHeight="false">
                        <HorizontalLayout preferredHeight="34" spacing="3" childForceExpandWidth="false">
                            <Text text="PM" class="caption blue" preferredWidth="45" />
                            <Text id="pmCurrent" text="21" class="blue" fontSize="28" preferredWidth="48" />
                            <Text text="/" class="muted" preferredWidth="16" />
                            <Text id="pmMax" text="21" fontSize="24" preferredWidth="44" />
                        </HorizontalLayout>
                        <HorizontalLayout preferredHeight="34" spacing="4" childForceExpandWidth="false">
                            <Button id="pm_subtract" class="miniButton" text="−" onClick="dispatch"
                                    preferredWidth="46" fontSize="24" />
                            <InputField id="pm_adjust" class="numberInput" text="" placeholder="VALOR"
                                        onEndEdit="dispatch" preferredWidth="105" characterLimit="4" />
                            <Button id="pm_add" class="miniButton" text="+" onClick="dispatch"
                                    preferredWidth="46" fontSize="24" />
                        </HorizontalLayout>
                    </VerticalLayout>
                </Panel>

                <Panel class="goldCard" preferredWidth="155">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 8" offsetMax="-8 -8"
                                    spacing="1" childForceExpandHeight="true">
                        <Text text="DEFESA" class="caption gold" preferredHeight="25" alignment="MiddleCenter" />
                        <Text id="defenseValue" text="24" fontSize="35" resizeTextMaxSize="38" />
                    </VerticalLayout>
                </Panel>

                <Panel class="card" preferredWidth="125">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 8" offsetMax="-8 -8"
                                    spacing="1" childForceExpandHeight="true">
                        <Text text="RD" class="caption gold" preferredHeight="25" alignment="MiddleCenter" />
                        <Text id="rdValue" text="8" fontSize="35" resizeTextMaxSize="38" />
                    </VerticalLayout>
                </Panel>

                <Button id="toggle_settings" class="baseButton" text="⚙&#10;AJUSTES" onClick="dispatch"
                        preferredWidth="100" />
            </HorizontalLayout>
        </Panel>

        <!-- Combat and powers -->
        <HorizontalLayout preferredHeight="425" spacing="8"
                          childForceExpandWidth="true" childForceExpandHeight="true">
            <Panel flexibleWidth="49">
                <VerticalLayout anchorMin="0 0" anchorMax="1 1" spacing="8"
                                childForceExpandWidth="true" childForceExpandHeight="false">
                    <Panel class="section" preferredHeight="140">
                        <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="9 7" offsetMax="-9 -8"
                                        spacing="5" childForceExpandWidth="true" childForceExpandHeight="false">
                            <HorizontalLayout preferredHeight="25" childForceExpandWidth="false">
                                <Text text="ARMA EM USO" class="caption gold" flexibleWidth="1" />
                                <Text id="activeWeaponLabel" text="ESPADA LONGA ATIVA" class="gold"
                                      alignment="MiddleRight" preferredWidth="240" />
                            </HorizontalLayout>
                            <HorizontalLayout flexibleHeight="1" spacing="8" childForceExpandWidth="true">
                                <Button id="weapon_sword" class="weaponButton" onClick="dispatch"
                                        colors="#302712|#493A18|#1D180D|#090B0D88"
                                        outline="#BE9139" outlineSize="2 2"
                                        text="ESPADA LONGA  •  ATIVA&#10;ATAQUE +13   •   DANO 1d8+5&#10;CRÍTICO 18–20/x2   •   CORTE" />
                                <Button id="weapon_shield" class="weaponButton" onClick="dispatch"
                                        text="ESCUDO PESADO&#10;ATAQUE +12   •   DANO 1d6+5&#10;DEFESA +4   •   CRÍTICO 20/x2   •   IMPACTO" />
                            </HorizontalLayout>
                        </VerticalLayout>
                    </Panel>

                    <Panel class="section" flexibleHeight="1">
                        <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="9 7" offsetMax="-9 -7"
                                        spacing="5" childForceExpandWidth="true" childForceExpandHeight="false">
                            <Text text="CÁLCULO ATUAL" class="caption" preferredHeight="20" />
                            <HorizontalLayout preferredHeight="42" spacing="6" childForceExpandWidth="true">
                                <Panel class="card">
                                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="4 2" offsetMax="-4 -2">
                                        <Text text="ATAQUE" class="caption" preferredHeight="16" alignment="MiddleCenter" />
                                        <Text id="attackValue" text="+13" fontSize="24" />
                                    </VerticalLayout>
                                </Panel>
                                <Panel class="card">
                                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="4 2" offsetMax="-4 -2">
                                        <Text text="DANO" class="caption" preferredHeight="16" alignment="MiddleCenter" />
                                        <Text id="damageValue" text="1d8+5" class="gold" fontSize="24" />
                                    </VerticalLayout>
                                </Panel>
                                <Panel class="card">
                                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="4 2" offsetMax="-4 -2">
                                        <Text text="CRÍTICO" class="caption" preferredHeight="16" alignment="MiddleCenter" />
                                        <Text id="criticalValue" text="18–20/x2" class="gold" fontSize="22" />
                                    </VerticalLayout>
                                </Panel>
                                <Panel class="card">
                                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="4 2" offsetMax="-4 -2">
                                        <Text text="DEFESA" class="caption" preferredHeight="16" alignment="MiddleCenter" />
                                        <Text id="calculatedDefenseValue" text="24" fontSize="24" />
                                    </VerticalLayout>
                                </Panel>
                            </HorizontalLayout>
                            <Text id="lastResult" text="ÚLTIMO RESULTADO  •  —"
                                  class="muted" preferredHeight="25" alignment="MiddleCenter"
                                  color="#CED0D0" outline="#000000AA" outlineSize="1 1" />
                            <HorizontalLayout preferredHeight="58" spacing="8" childForceExpandWidth="true">
                                <Button id="roll_attack" class="dangerAction" text="ROLAR ATAQUE&#10;d20 + modificadores"
                                        onClick="dispatch" />
                                <Button id="roll_damage" class="goldAction" text="ROLAR DANO&#10;dados da arma + bônus"
                                        onClick="dispatch" />
                                <Button id="roll_critical" class="greenAction" text="CRÍTICO&#10;confirmar ameaça"
                                        onClick="dispatch" />
                            </HorizontalLayout>
                            <Text id="activeEffects" text="EFEITOS ATIVOS  •  nenhum"
                                  class="muted" preferredHeight="21" alignment="MiddleLeft" />
                        </VerticalLayout>
                    </Panel>
                </VerticalLayout>
            </Panel>

            <Panel class="section" flexibleWidth="51">
                <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 8" offsetMax="-10 -8"
                                spacing="6" childForceExpandWidth="true" childForceExpandHeight="false">
                    <HorizontalLayout preferredHeight="26" childForceExpandWidth="false">
                        <Text text="PODERES E RECURSOS" class="caption gold" flexibleWidth="1" />
                        <Text id="activePowersLabel" text="ATIVOS  •  nenhum" class="muted"
                              alignment="MiddleRight" preferredWidth="390" />
                    </HorizontalLayout>
                    <GridLayout flexibleHeight="1" cellSize="365 116" spacing="7 7"
                                constraint="FixedColumnCount" constraintCount="2"
                                childAlignment="UpperCenter" startCorner="UpperLeft" startAxis="Horizontal">
                        <Button id="power_combat_defensive" class="powerButton" onClick="dispatch"
                                text="COMBATE DEFENSIVO  •  0 PM&#10;−2 no próximo ataque&#10;+5 DEF até o próximo turno" />
                        <Button id="power_duel" class="powerButton" onClick="dispatch"
                                colors="#201615|#39201D|#130D0C|#090B0D88" outline="#76332B"
                                text="DUELO  •  2/3 PM&#10;+2 ou +3 ataque, dano e RD&#10;dura até o fim da cena" />
                        <Panel>
                            <HorizontalLayout anchorMin="0 0" anchorMax="1 1" spacing="5"
                                              childForceExpandWidth="true" childForceExpandHeight="true">
                                <Button id="power_baluarte" class="powerButton" onClick="dispatch"
                                        colors="#111C24|#1C3444|#0A1116|#090B0D88" outline="#315F7A"
                                        text="BALUARTE  •  1/2 PM&#10;+2 ou +4 DEF/resistências&#10;até o próximo turno" />
                                <Button id="power_baluarte_allies" class="powerButton" onClick="dispatch"
                                        interactable="false" preferredWidth="122"
                                        colors="#14261D|#20402E|#0C1711|#090B0D88" outline="#39724F"
                                        text="ALIADOS  •  +2 PM&#10;ative Baluarte primeiro&#10;para compartilhar" />
                            </HorizontalLayout>
                        </Panel>
                        <Panel id="passive_duelist_shielded" class="goldCard">
                            <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 7" offsetMax="-10 -7"
                                            spacing="2" childForceExpandWidth="true" childForceExpandHeight="true">
                                <Text text="DUELISTA ESCUDADO" class="gold" fontSize="18" preferredHeight="28" />
                                <Text text="Duelo ativo: RD +2 ou +3" class="muted" fontSize="14" />
                                <Text text="ARMAS DA AMBIÇÃO" class="gold" fontSize="17" preferredHeight="28" />
                                <Text text="espada +1 ataque • ameaça +1" class="muted" fontSize="14" />
                            </VerticalLayout>
                        </Panel>
                        <Button id="power_provocacao" class="powerButton" onClick="dispatch"
                                colors="#201312|#3A201C|#140B0A|#090B0D88" outline="#753129"
                                text="PROVOCAÇÃO  •  2 PM&#10;Vontade CD 16&#10;postura até fim da cena" />
                        <Panel class="goldCard">
                            <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 7" offsetMax="-10 -7"
                                            spacing="2" childForceExpandWidth="true" childForceExpandHeight="true">
                                <Text text="ESTILO + SOLIDEZ + ENCOURAÇADO" class="gold" fontSize="17" preferredHeight="28" />
                                <Text text="escudo +4 refletido em DEF e resistências" class="muted" fontSize="14" />
                                <Text text="BASTIÃO + PLACAS DA IRA" class="gold" fontSize="17" preferredHeight="28" />
                                <Text text="RD 5 + 3 = 8  •  PASSIVOS" class="muted" fontSize="14" />
                            </VerticalLayout>
                        </Panel>
                    </GridLayout>
                </VerticalLayout>
            </Panel>
        </HorizontalLayout>

        <!-- Quick skills and lifecycle -->
        <Panel preferredHeight="182">
            <VerticalLayout anchorMin="0 0" anchorMax="1 1" spacing="7"
                            childForceExpandWidth="true" childForceExpandHeight="false">
                <Panel class="section" preferredHeight="92">
                    <HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="9 6" offsetMax="-9 -6"
                                      spacing="6" childForceExpandWidth="true" childForceExpandHeight="true">
                        <Text text="ATALHOS&#10;RÁPIDOS" class="caption gold" preferredWidth="104" alignment="MiddleLeft" />
                        <GridLayout flexibleWidth="1" cellSize="242 37" spacing="6 4"
                                    constraint="FixedColumnCount" constraintCount="6"
                                    childAlignment="MiddleCenter" startCorner="UpperLeft" startAxis="Horizontal">
                            <Button id="skill_iniciativa" class="skillButton" text="INICIATIVA  +3" onClick="dispatch" />
                            <Button id="skill_luta" class="skillButton" text="LUTA  +12" onClick="dispatch" />
                            <Button id="skill_intimidacao" class="skillButton" text="INTIMIDAÇÃO  +6" onClick="dispatch" />
                            <Button id="skill_percepcao" class="skillButton" text="PERCEPÇÃO  +8" onClick="dispatch" />
                            <Button id="skill_fortitude" class="skillButton" text="FORTITUDE  +15" onClick="dispatch" />
                            <Button id="skill_reflexos" class="skillButton" text="REFLEXOS  +7" onClick="dispatch" />
                            <Button id="skill_vontade" class="skillButton" text="VONTADE  +8" onClick="dispatch" />
                            <Button id="skill_cavalgar" class="skillButton" text="CAVALGAR  +7" onClick="dispatch" />
                            <Button id="skill_diplomacia" class="skillButton" text="DIPLOMACIA  +10" onClick="dispatch" />
                            <Button id="skill_guerra" class="skillButton" text="GUERRA  +8" onClick="dispatch" />
                            <Button id="skill_pontaria" class="skillButton" text="PONTARIA  +7" onClick="dispatch" />
                        </GridLayout>
                    </HorizontalLayout>
                </Panel>

                <HorizontalLayout flexibleHeight="1" spacing="8"
                                  childForceExpandWidth="true" childForceExpandHeight="true">
                    <Button id="end_turn" class="baseButton" onClick="dispatch"
                            colors="#142631|#1E3B4C|#0D1820|#090B0D88" outline="#315C72"
                            text="INÍCIO DO TURNO&#10;limpa efeitos temporários" />
                    <Button id="end_scene" class="baseButton" onClick="dispatch"
                            text="FIM DA CENA&#10;encerra Duelo e efeitos" />
                    <Button id="undo" class="baseButton" onClick="dispatch"
                            text="DESFAZER&#10;última mudança de estado" />
                    <Button id="clear_dice" class="baseButton" onClick="dispatch"
                            text="LIMPAR DADOS&#10;remove os dados do painel" />
                    <Panel class="goldCard" preferredWidth="420">
                        <HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 5" offsetMax="-8 -5"
                                          spacing="8" childForceExpandWidth="false" childForceExpandHeight="true">
                            <VerticalLayout flexibleWidth="1" spacing="0"
                                            childForceExpandWidth="true" childForceExpandHeight="false">
                                <HorizontalLayout preferredHeight="22" childForceExpandWidth="false">
                                    <Text text="RUNTIME" class="caption gold" preferredWidth="82" />
                                    <Text id="versionLabel" text="v0.2.0 • offline pronto" class="muted"
                                          alignment="MiddleRight" flexibleWidth="1" />
                                </HorizontalLayout>
                                <Text id="refreshStatus" text="ATUALIZAÇÃO  •  pronta"
                                      class="muted" alignment="MiddleLeft" preferredHeight="22" />
                            </VerticalLayout>
                            <Button id="refresh" class="goldAction" text="REFRESH"
                                    onClick="refresh" preferredWidth="112" />
                        </HorizontalLayout>
                    </Panel>
                </HorizontalLayout>
            </VerticalLayout>
        </Panel>
    </VerticalLayout>

    <!-- Overlay stays below the header gear, so toggle_settings remains reachable. -->
    <Panel id="settingsPanel" active="false" width="620" height="510"
           rectAlignment="UpperRight" offsetXY="-18 -112"
           color="#090D11FC" outline="#B08738" outlineSize="3 3"
           showAnimation="SlideIn_Right" hideAnimation="SlideOut_Right"
           animationDuration="0.18" raycastTarget="true">
        <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="16 14" offsetMax="-16 -14"
                        spacing="8" childForceExpandWidth="true" childForceExpandHeight="false">
            <HorizontalLayout preferredHeight="38" childForceExpandWidth="false">
                <Text text="CONFIGURAÇÕES" class="gold" fontSize="25"
                      alignment="MiddleLeft" flexibleWidth="1" />
                <Text text="compartilhadas" class="muted" alignment="MiddleRight" preferredWidth="180" />
            </HorizontalLayout>
            <Text text="POSIÇÃO LOCAL DOS DADOS" class="caption" preferredHeight="22" />
            <HorizontalLayout preferredHeight="66" spacing="8" childForceExpandWidth="true">
                <Panel class="card">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="6 4" offsetMax="-6 -4" spacing="2">
                        <Text text="OFFSET X" class="caption" alignment="MiddleCenter" preferredHeight="22" />
                        <InputField id="offset_x" class="decimalInput" text="0" onEndEdit="dispatch" />
                    </VerticalLayout>
                </Panel>
                <Panel class="card">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="6 4" offsetMax="-6 -4" spacing="2">
                        <Text text="OFFSET Y" class="caption" alignment="MiddleCenter" preferredHeight="22" />
                        <InputField id="offset_y" class="decimalInput" text="2.5" onEndEdit="dispatch" />
                    </VerticalLayout>
                </Panel>
                <Panel class="card">
                    <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="6 4" offsetMax="-6 -4" spacing="2">
                        <Text text="OFFSET Z" class="caption" alignment="MiddleCenter" preferredHeight="22" />
                        <InputField id="offset_z" class="decimalInput" text="-5" onEndEdit="dispatch" />
                    </VerticalLayout>
                </Panel>
            </HorizontalLayout>
            <Button id="calibrate_roll" class="baseButton" text="ROLAGEM DE TESTE  •  calibrar posição"
                    onClick="dispatch" preferredHeight="46"
                    colors="#152633|#204056|#0D1820|#090B0D88" outline="#35627D" />
            <Panel class="card" preferredHeight="70">
                <HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 6" offsetMax="-10 -6"
                                  spacing="12" childForceExpandWidth="false" childForceExpandHeight="true">
                    <VerticalLayout flexibleWidth="1" spacing="1"
                                    childForceExpandWidth="true" childForceExpandHeight="false">
                        <Text text="GASTO AUTOMÁTICO DE RECURSOS" class="caption gold"
                              preferredHeight="23" />
                        <Text text="Desconta e valida PV/PM ao ativar poderes."
                              class="muted" alignment="MiddleLeft" />
                    </VerticalLayout>
                    <Toggle id="automatic_resource_spending" isOn="true" onValueChanged="dispatch"
