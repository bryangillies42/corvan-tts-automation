                tooltipPosition="Above" tooltipFontSize="15"
                tooltipTextColor="#F3EEE3" tooltipBackgroundColor="#07090CF5"
                tooltipBorderColor="#9E7A31" />
        <Button class="weaponButton" fontSize="18" fontStyle="Bold" textColor="#E7E0D3"
