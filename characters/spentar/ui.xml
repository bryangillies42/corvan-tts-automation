<!--
  Spentar UI contract
  ===================
  The visible panel is deliberately opaque and self-contained. It does not use an
  XML Image or a remote texture, so a failed asset request cannot turn the console
  into a white rectangle in Tabletop Simulator.

  Navigation and all actions are routed through dispatch. The runtime may update
  text, colors, interactable and active on the IDs declared below.
-->
<Defaults>
  <Text color="#EDE7F3" fontSize="20" fontStyle="Bold" raycastTarget="false"
        alignment="MiddleCenter" resizeTextForBestFit="true"
        resizeTextMinSize="11" resizeTextMaxSize="25"
        horizontalOverflow="Wrap" verticalOverflow="Truncate" />
  <Text class="label" color="#A99AB8" fontSize="14" fontStyle="Bold"
        alignment="MiddleLeft" resizeTextMinSize="10" resizeTextMaxSize="16" />
  <Text class="muted" color="#A69DAB" fontSize="15" fontStyle="Normal"
        resizeTextMinSize="10" resizeTextMaxSize="18" />
  <Text class="violet" color="#C69CFF" />
  <Text class="cyan" color="#6EDBE3" />
  <Text class="red" color="#F07878" />
  <Text class="green" color="#8AD29A" />
  <Text class="gold" color="#E1BD68" />

  <Panel raycastTarget="false" />
  <Panel class="surface" color="#100D17FF" outline="#5E496F" outlineSize="1 1" />
  <Panel class="card" color="#17121FFF" outline="#493956" outlineSize="1 1" />
  <Panel class="focusCard" color="#1C1427FF" outline="#9A6BC3" outlineSize="2 2" />
  <Panel class="dangerCard" color="#211318FF" outline="#9B4F60" outlineSize="2 2" />

  <Button class="baseButton" fontSize="17" fontStyle="Bold" textColor="#F3EDF6"
          textAlignment="MiddleCenter" resizeTextForBestFit="true"
          resizeTextMinSize="10" resizeTextMaxSize="19"
          colors="#281D34FF|#3A2950FF|#1B1423FF|#100C16AA"
          outline="#644C79" outlineSize="1 1" padding="6 6 4 4" />
  <Button class="navButton" fontSize="18" fontStyle="Bold" textColor="#EDE5F2"
          textAlignment="MiddleCenter" resizeTextForBestFit="true"
          resizeTextMinSize="11" resizeTextMaxSize="20"
          colors="#1B1623FF|#322541FF|#120E19FF|#0B0910AA"
          outline="#4A3957" outlineSize="1 1" />
  <Button class="miniButton" fontSize="19" fontStyle="Bold" textColor="#F4EDF8"
          textAlignment="MiddleCenter" colors="#251C30FF|#3D2B50FF|#17111FFF|#0D0912AA"
          outline="#5A456AFF" outlineSize="1 1" padding="2 2 1 1" />
  <Button class="spellButton" fontSize="15" fontStyle="Bold" textColor="#EDE5F2"
          textAlignment="MiddleCenter" resizeTextForBestFit="true"
          resizeTextMinSize="10" resizeTextMaxSize="17"
          colors="#24192FFF|#3B2850FF|#17101FFF|#0D0912AA"
          outline="#60477AFF" outlineSize="1 1" padding="5 5 3 3" />
  <Button class="primaryButton" fontSize="19" fontStyle="Bold" textColor="#F5ECFFFF"
          textAlignment="MiddleCenter" resizeTextForBestFit="true"
          resizeTextMinSize="12" resizeTextMaxSize="21"
          colors="#563375FF|#74459BFF|#351F49FF|#1C1028AA"
          outline="#B47BE0FF" outlineSize="2 2" padding="6 6 4 4" />
  <Button class="dangerButton" fontSize="17" fontStyle="Bold" textColor="#FFE8EC"
          textAlignment="MiddleCenter" resizeTextForBestFit="true"
          resizeTextMinSize="11" resizeTextMaxSize="19"
          colors="#672D3AFF|#873D4DFF|#421D26FF|#211015AA"
          outline="#B65C70" outlineSize="2 2" padding="5 5 3 3" />
</Defaults>

<Panel id="spentarConsole" width="1600" height="1000" rectAlignment="MiddleCenter"
       position="0 0 -30" rotation="0 0 180" scale="0.25 0.25 1"
       color="#09070DFF" outline="#8D63A8" outlineSize="4 4" raycastTarget="false">
  <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="14 12" offsetMax="-14 -12"
                  spacing="8" childForceExpandWidth="true" childForceExpandHeight="false">

    <!-- Persistent resource and state bar -->
