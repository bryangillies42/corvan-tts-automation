                <Button id="resolution_apply" class="dangerButton" text="APLICAR E CONCLUIR" onClick="dispatch" preferredHeight="62" />
              </VerticalLayout>
            </Panel>
          </Panel>
        </VerticalLayout>
      </Panel>

      <Panel id="page_necromancy" active="false" anchorMin="0 0" anchorMax="1 1" class="surface">
