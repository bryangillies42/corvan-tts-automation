              </HorizontalLayout>
            </VerticalLayout>
          </Panel>
          <Panel class="card" preferredWidth="190">
            <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="6 4" offsetMax="-6 -4" spacing="2">
              <Text text="PM TEMPORÁRIOS" class="label violet" alignment="MiddleCenter" preferredHeight="27" />
              <HorizontalLayout preferredHeight="43" spacing="3" childForceExpandWidth="true">
                <Button id="resource_temp_mp_sub" class="miniButton" text="-" onClick="dispatch" />
                <Text id="resource_temp_mp" text="0" class="violet" fontSize="26" />
