                <Panel class="card" preferredHeight="72"><Text id="cast_details" text="CD 25 • FORTITUDE REDUZ À METADE • PROFANAR INATIVO" class="muted" alignment="MiddleLeft" /></Panel>
                <Text id="cast_spending_notice" text="Ao confirmar, PM e almas serão consumidos em uma única transação. Uma falha restaura tudo." class="muted" preferredHeight="38" />
