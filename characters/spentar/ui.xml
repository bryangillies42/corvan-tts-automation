              <Text text="ESTADOS" class="label violet" alignment="MiddleCenter" preferredHeight="22" />
              <Text id="souls_value" text="ALMAS 0 / 6" class="violet" preferredHeight="22" />
              <Text id="profanar_value" text="PROFANAR: INATIVO" class="muted" preferredHeight="20" />
              <Text id="connection_value" text="CONEXÃO: INATIVA" class="muted" preferredHeight="20" />
            </VerticalLayout>
          </Panel>
        </HorizontalLayout>

        <HorizontalLayout preferredHeight="54" spacing="5" childForceExpandWidth="true">
          <Panel class="card"><Text text="DEFESA" class="label" alignment="UpperCenter" /><Text id="defense_value" text="17" class="gold" fontSize="26" alignment="LowerCenter" /></Panel>
          <Panel class="card"><Text text="FORTITUDE" class="label" alignment="UpperCenter" /><Text id="fortitude_value" text="+7" fontSize="26" alignment="LowerCenter" /></Panel>
          <Panel class="card"><Text text="REFLEXOS" class="label" alignment="UpperCenter" /><Text id="reflex_value" text="+10" fontSize="26" alignment="LowerCenter" /></Panel>
          <Panel class="card"><Text text="VONTADE" class="label" alignment="UpperCenter" /><Text id="will_value" text="+8" fontSize="26" alignment="LowerCenter" /></Panel>
          <Panel class="card"><Text text="CD GERAL" class="label" alignment="UpperCenter" /><Text id="general_dc" text="23" class="cyan" fontSize="26" alignment="LowerCenter" /></Panel>
          <Panel class="focusCard"><Text text="CD NECROMANCIA" class="label violet" alignment="UpperCenter" /><Text id="necro_dc" text="25" class="violet" fontSize="26" alignment="LowerCenter" /></Panel>
          <Button id="toggle_staff" class="baseButton" text="CAJADO&#10;2 MÃOS: SIM" onClick="dispatch" />
          <Button id="toggle_profanar" class="baseButton" text="PREPARAR&#10;PROFANAR" onClick="dispatch" />
        </HorizontalLayout>
      </VerticalLayout>
    </Panel>

    <!-- Persistent navigation -->
    <HorizontalLayout preferredHeight="58" spacing="6" childForceExpandWidth="true">
      <Button id="nav_combat" class="navButton" text="COMBATE" onClick="dispatch" />
      <Button id="nav_casting" class="navButton" text="CONJURAÇÃO" onClick="dispatch" />
      <Button id="nav_necromancy" class="navButton" text="NECROMANCIA" onClick="dispatch" />
      <Button id="nav_sheet" class="navButton" text="FICHA" onClick="dispatch" />
      <Button id="nav_settings" class="navButton" text="AJUSTES" onClick="dispatch" />
    </HorizontalLayout>

    <!-- Page stack: the runtime keeps exactly one page active. -->
    <Panel id="pageStack" preferredHeight="655" color="#08060B00">
      <Panel id="page_combat" active="true" anchorMin="0 0" anchorMax="1 1" class="surface">
