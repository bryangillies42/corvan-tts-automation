                </VerticalLayout>
              </Panel>
            </VerticalLayout>
          </Panel>
        </HorizontalLayout>
      </Panel>

      <Panel id="page_casting" active="false" anchorMin="0 0" anchorMax="1 1" class="surface">
        <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 9" offsetMax="-10 -9"
                        spacing="6" childForceExpandWidth="true" childForceExpandHeight="false">
