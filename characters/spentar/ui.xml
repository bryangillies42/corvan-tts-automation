      <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 8" offsetMax="-10 -8"
                      spacing="5" childForceExpandWidth="true" childForceExpandHeight="false">
        <HorizontalLayout preferredHeight="96" spacing="6"
