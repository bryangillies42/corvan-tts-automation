                  <Panel class="card"><HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 7" offsetMax="-10 -7" spacing="5"><Text text="APRIMORAMENTOS" class="label" flexibleWidth="1" /><Button id="cast_upgrade_sub" class="miniButton" text="-" onClick="dispatch" preferredWidth="54" /><Text id="cast_upgrade_value" text="0" preferredWidth="70" /><Button id="cast_upgrade_add" class="miniButton" text="+" onClick="dispatch" preferredWidth="54" /></HorizontalLayout></Panel>
                  <Panel class="card"><HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 7" offsetMax="-10 -7" spacing="5"><Text text="ALVOS" class="label" flexibleWidth="1" /><Button id="cast_targets_sub" class="miniButton" text="-" onClick="dispatch" preferredWidth="54" /><Text id="cast_targets_value" text="1" preferredWidth="70" /><Button id="cast_targets_add" class="miniButton" text="+" onClick="dispatch" preferredWidth="54" /></HorizontalLayout></Panel>
                </HorizontalLayout>
                <Panel class="card" preferredHeight="55"><HorizontalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 7" offsetMax="-10 -7" spacing="5"><Text text="ALMAS A LIBERAR" class="label" flexibleWidth="1" /><Text text="Cada alma adiciona 2d6 de trevas" class="muted" preferredWidth="390" /><Button id="cast_souls_sub" class="miniButton" text="-" onClick="dispatch" preferredWidth="54" /><Text id="cast_souls_value" text="0" preferredWidth="70" /><Button id="cast_souls_add" class="miniButton" text="+" onClick="dispatch" preferredWidth="54" /></HorizontalLayout></Panel>
                <Panel class="card" preferredHeight="48"><Text text="PROFANAR e CAJADO usam os estados da barra superior. Fichas inimigas nunca serão alteradas automaticamente." class="muted" alignment="MiddleLeft" /></Panel>
                <Text text="PRÓXIMO PASSO: confira exatamente o que será consumido e rolado." class="gold" preferredHeight="24" />
                <Button id="cast_review" class="primaryButton" text="REVISAR CONJURAÇÃO" onClick="dispatch" preferredHeight="52" />
              </VerticalLayout>
            </Panel>

            <Panel id="casting_review_panel" active="false" anchorMin="0 0" anchorMax="1 1" class="focusCard">
              <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="18 14" offsetMax="-18 -14" spacing="6" childForceExpandWidth="true" childForceExpandHeight="false">
                <Text text="CONFIRA ANTES DE CONFIRMAR" class="label gold" preferredHeight="22" />
                <Text id="cast_spell_name" text="INFLIGIR FERIMENTOS" class="violet" fontSize="29" alignment="MiddleLeft" preferredHeight="36" />
                <HorizontalLayout preferredHeight="58" spacing="8">
                  <Panel class="card"><Text id="cast_cost" text="CUSTO: 1 PM" class="cyan" fontSize="24" alignment="MiddleLeft" /></Panel>
                  <Panel class="card"><Text id="cast_damage" text="DANO: 3d8+9 TREVAS" class="red" fontSize="24" alignment="MiddleLeft" /></Panel>
