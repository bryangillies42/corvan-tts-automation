                  <Text text="RAIO ARCANO DIVIDIDO" class="violet" fontSize="22" preferredHeight="31" />
                  <Text text="3d8+6 • ESSÊNCIA • REFLEXOS • CD ATUAL" class="muted" preferredHeight="25" />
                  <Button id="quick_arcane_bolt" class="primaryButton" text="PREPARAR RAIO ARCANO" onClick="dispatch" preferredHeight="30" />
                </VerticalLayout>
              </Panel>
              <Panel class="card" preferredHeight="95">
                <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 5" offsetMax="-8 -5" spacing="2">
