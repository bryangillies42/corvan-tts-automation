            <Text text="CONJURAÇÃO GUIADA" class="label violet" preferredWidth="260" />
            <Text id="casting_step" text="ETAPA 1 DE 4 • CONFIGURAR" class="gold" alignment="MiddleLeft" flexibleWidth="1" />
