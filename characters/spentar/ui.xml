                  <Button id="quick_inflict_wounds" class="primaryButton" text="PREPARAR INFLIGIR" onClick="dispatch" preferredHeight="30" />
                </VerticalLayout>
              </Panel>
              <Panel class="card" preferredHeight="95">
                <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="8 5" offsetMax="-8 -5" spacing="2">
                  <Text text="CONJURAR MORTOS VIVOS" class="violet" fontSize="22" preferredHeight="31" />
                  <Text text="Nd6 + 2N + INT 6 • TREVAS" class="muted" preferredHeight="25" />
                  <Button id="quick_animate_dead" class="primaryButton" text="PREPARAR MORTOS-VIVOS" onClick="dispatch" preferredHeight="30" />
                </VerticalLayout>
              </Panel>
              <Text text="O resolvedor aplica Profanar somente aos grupos de dano de trevas e mostra o cálculo antes da confirmação." class="muted" preferredHeight="55" />
            </VerticalLayout>
          </Panel>
          <Panel class="card" flexibleWidth="44">
            <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="10 9" offsetMax="-10 -9"
                            spacing="7" childForceExpandWidth="true" childForceExpandHeight="false">
              <Text text="PERÍCIAS DE COMBATE" class="label gold" preferredHeight="25" />
              <HorizontalLayout preferredHeight="54" spacing="6"><Button id="skill_initiative" class="baseButton" text="INICIATIVA +6" onClick="dispatch" /><Button id="skill_fortitude" class="baseButton" text="FORTITUDE +7" onClick="dispatch" /></HorizontalLayout>
              <HorizontalLayout preferredHeight="54" spacing="6"><Button id="skill_reflex" class="baseButton" text="REFLEXOS +10" onClick="dispatch" /><Button id="skill_will" class="baseButton" text="VONTADE +8" onClick="dispatch" /></HorizontalLayout>
              <HorizontalLayout preferredHeight="54" spacing="6"><Button id="skill_mysticism" class="baseButton" text="MISTICISMO +14" onClick="dispatch" /><Button id="skill_perception" class="baseButton" text="PERCEPÇÃO +3" onClick="dispatch" /></HorizontalLayout>
              <Panel class="focusCard" preferredHeight="125">
                <VerticalLayout anchorMin="0 0" anchorMax="1 1" offsetMin="9 6" offsetMax="-9 -6" spacing="3">
                  <Text text="AGRILHOAR OS CAÍDOS" class="violet" preferredHeight="27" />
                  <Text text="Cada alma guardada: +2 Defesa e resistências. Cada alma liberada em uma magia de dano: +2d6 trevas." class="muted" preferredHeight="55" />
