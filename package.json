{
  "name": "corvan-tts-automation",
  "private": true,
  "type": "module",
  "description": "Ferramentas para Saved Objects de personagens no Tabletop Simulator",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:character": "node scripts/build.mjs",
    "build:fixture": "node scripts/build.mjs --fixture arcane-test",
    "character:new": "node scripts/new-character.mjs",
    "test": "node --test",
    "test:lua": "pwsh -NoProfile -File scripts/smoke-moonsharp.ps1",
    "verify:tts-assets": "node scripts/verify-tts-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
